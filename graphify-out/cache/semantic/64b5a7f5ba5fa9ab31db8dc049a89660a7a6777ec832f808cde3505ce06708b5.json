{"nodes": [{"id": "project_c_memory_memory", "label": "Location-Based Reminders Refactor Progress", "file_type": "document", "source_file": "memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_c_memory_play_services_geofencing_plan", "label": "Play Services Geofencing API Integration", "file_type": "rationale", "source_file": "memory.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the custom CustomLocationService with Google Play Services Geofencing for location-based reminders. Geofences are registered with ENTER/DWELL transitions plus a loitering delay, expire per-reminder date, handle GEOFENCE_TOO_MANY_GEOFENCES, and firing is debounced with a 10-minute cooldown. Permission routing is handled smartly from RemindersScreen (routes to PermissionScreen when permissions are missing), and geofences are re-registered on boot (BootCompletedReceiver) and in MainActivity as a safety net."}], "edges": [{"source": "project_c_memory_memory", "target": "project_c_memory_play_services_geofencing_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory.md", "source_location": null, "weight": 1.0}, {"source": "project_c_memory_play_services_geofencing_plan", "target": "geofencing_geofencemanagerimpl_geofencemanagerimpl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory.md", "source_location": null, "weight": 1.0}, {"source": "project_c_memory_play_services_geofencing_plan", "target": "notification_notificationhelper_notificationhelper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "memory.md", "source_location": null, "weight": 1.0}, {"source": "project_c_memory_play_services_geofencing_plan", "target": "repository_reminderrepository_reminderrepository", "relation": "refe